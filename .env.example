# ---- Django ----
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-in-production
DEBUG=1
ALLOWED_HOSTS=*
LOG_LEVEL=INFO

# ---- Auth (SimpleJWT, HS256) ----
# Optional. Falls back to SECRET_KEY when unset or blank.
# JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ---- Datastores ----
DATABASE_URL=postgres://notify:notify@postgres:5432/notify
DB_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=

# ---- Dispatch tuning ----
# Per-user lock lease; refreshed while a worker is draining.
USER_LOCK_TTL_SECONDS=30
# Hard timeout around a provider call.
PROVIDER_TIMEOUT_SECONDS=2.0
# Total attempts per notification before marking failed.
MAX_ATTEMPTS=3
# Exponential backoff base (with jitter).
RETRY_BASE_DELAY_SECONDS=1.0
RETRY_MAX_DELAY_SECONDS=30.0
SWEEP_INTERVAL_SECONDS=30
# Processing rows older than this are considered orphaned.
STALE_PROCESSING_SECONDS=120
# How many notifications one drain task handles before re-queuing itself.
MAX_DRAIN_PER_TASK=200
SIMULATED_FAILURE_RATE=0.10
SIMULATED_MIN_LATENCY_MS=50
SIMULATED_MAX_LATENCY_MS=300

# ---- Gunicorn ----
WEB_CONCURRENCY=4
GUNICORN_THREADS=4
